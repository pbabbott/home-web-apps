PORT=4004

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DATABASE=homelab_api
POSTGRES_USER=homelab_api
POSTGRES_PASSWORD=Password123

# Decrypts the source connection passwords. Must be the same value
# homelab-api uses: `openssl rand -base64 32`.
EXODUS_CREDENTIAL_KEY=

# The backup destination (backup_destinations.id) this worker serves.
BACKUP_DESTINATION_ID=00000000-0000-0000-0000-000000000000

# Absolute path of the mounted export. Locally: a scratch directory.
BACKUP_DESTINATION_PATH=/change/me/to/a/local/scratch/directory

# `nfs` checks /proc/mounts for the destination's server:exportPath.
# `none` is for local development only; validation then records
# mountVerified: false.
BACKUP_DESTINATION_MOUNT_CHECK=none

# How often (ms) the worker polls (touches worker_seen_at, checks for a
# validation request). The API treats a worker as stale after 2 minutes.
POLL_INTERVAL_MS=5000

# No-progress timeout for destination operations. A call stalled this long
# marks the destination unhealthy and fails /readyz.
BACKUP_STALL_TIMEOUT_SECONDS=120

# Used by the copy engine (not built yet).
BACKUP_PARALLELISM=1
BACKUP_HEARTBEAT_SECONDS=60
BACKUP_LEASE_SECONDS=300
