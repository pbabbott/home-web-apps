{
  "name": "@abbottland/homelab-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docker:build:base": "abctl docker build -c abctl.base.yml",
    "docker:build": "abctl docker build",
    "docker:publish:base": "abctl docker publish -c abctl.base.yml",
    "docker:publish": "abctl docker publish",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node ./dist/index.js\"",
    "dev:deps": "docker compose --ansi=never -f ./docker-compose.yaml up -d --quiet-pull --wait",
    "dev:deps:down": "docker compose --ansi=never -f ./docker-compose.yaml down -v",
    "env:generate": "abctl secrets generate-env",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts*\" --max-warnings 0",
    "seed:remote": "ts-node -P tsconfig.build.json src/scripts/seed-from-remote.ts",
    "start": "node ./dist/index.js",
    "test": "pnpm run test:unit && pnpm run test:int",
    "test:int": "jest --config jest.config.ts --selectProjects integration --runInBand",
    "test:unit": "jest --config jest.config.ts --selectProjects unit"
  },
  "dependencies": {
    "@abbottland/express": "workspace:*",
    "@abbottland/homelab-db": "workspace:*",
    "@abbottland/yaml-config": "workspace:*",
    "@kubernetes/client-node": "catalog:",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^16.6.1",
    "express": "catalog:",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "catalog:",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "@abbottland/abctl": "workspace:*",
    "@abbottland/eslint-config": "workspace:*",
    "@abbottland/jest-presets": "workspace:*",
    "@abbottland/typescript-config": "workspace:*",
    "@types/express": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "catalog:",
    "jest-junit": "^16.0.0",
    "supertest": "^7.1.4",
    "ts-node": "catalog:",
    "tsc-watch": "^6.3.1",
    "typescript": "catalog:"
  }
}
