PORT=4003

# Base URL of the kube-prometheus-stack Prometheus instance used to enrich
# Kubernetes pod/deployment/node data with live CPU & memory usage. No path —
# endpoints are appended by the client (src/api/prometheus/prometheus-client.ts).
PROMETHEUS_URL=https://prometheus.local.abbottland.io

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DATABASE=homelab_api
POSTGRES_USER=homelab_api
POSTGRES_PASSWORD=Password123

# Encrypts the credentials saved for a source's file preview (AES-256-GCM).
# 32 random bytes, base64: `openssl rand -base64 32`. Losing or changing it
# makes stored source passwords unreadable (re-enter them). Optional: without
# it everything else works and the connection/preview routes answer 503.
EXODUS_CREDENTIAL_KEY=

# The /media routes (home-hud's Media page). All optional: without credentials
# the matching route answers 503 ("... is not configured") and nothing else is
# affected. The keys and qBittorrent login are filled in by `pnpm env:generate`
# from the `mcp-arr` and `qbittorrent.local.abbottland.io` 1Password items.
# Locally the services are reached through their LAN routes; in the cluster the
# URLs default to the media namespace's services (see homelab-api-deployment.yaml).
SONARR_URL=https://sonarr.local.abbottland.io
SONARR_API_KEY=
RADARR_URL=https://radarr.local.abbottland.io
RADARR_API_KEY=
QBITTORRENT_URL=https://qbittorrent.local.abbottland.io
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
