PORT=4003

# Base URL of the kube-prometheus-stack Prometheus instance used to enrich
# Kubernetes pod/deployment/node data with live CPU & memory usage. No path —
# endpoints are appended by the client (src/api/prometheus/prometheus-client.ts).
PROMETHEUS_URL=https://prometheus.local.abbottland.io

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DATABASE=homelab_api
POSTGRES_USER=homelab_api
POSTGRES_PASSWORD=Password123

# Encrypts the credentials saved for a source's file preview (AES-256-GCM).
# 32 random bytes, base64: `openssl rand -base64 32`. Losing or changing it
# makes stored source passwords unreadable (re-enter them). Optional: without
# it everything else works and the connection/preview routes answer 503.
EXODUS_CREDENTIAL_KEY=
