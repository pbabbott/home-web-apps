PORT=4006

# Same database as budget-api (jobs are created there and claimed here), so in
# dev both use the Postgres that either app's `pnpm dev:deps` starts on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=budget
POSTGRES_USER=budget
POSTGRES_PASSWORD=Password123

# How often (ms) an idle worker polls for a pending job.
POLL_INTERVAL_MS=5000

# Base URL of the YNAB API. Endpoints are appended by the client.
YNAB_API_URL=https://api.ynab.com/v1

# The one plan (budget) to sync: the id from its app.ynab.com URL
# (app.ynab.com/<plan id>/budget). Only this plan is ever synced.
YNAB_PLAN_ID=8e6e759d-2422-478d-85d6-888fa5a7cda8

# YNAB Personal Access Token (YNAB > Account Settings > Developer Settings).
# Rate limited to 200 requests/hour; ynab_sync stays well under that.
YNAB_API_TOKEN=secret_value_goes_here
