    "public.ynab_transactions_enriched": {
      "columns": {
        "plan_id": {
          "name": "plan_id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "id": {
          "name": "id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "date": {
          "name": "date",
          "type": "date",
          "primaryKey": false,
          "notNull": true
        },
        "memo": {
          "name": "memo",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "cleared": {
          "name": "cleared",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "approved": {
          "name": "approved",
          "type": "boolean",
          "primaryKey": false,
          "notNull": true
        },
        "account_id": {
          "name": "account_id",
          "type": "text",
          "primaryKey": false,
          "notNull": true
        },
        "payee_id": {
          "name": "payee_id",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "category_id": {
          "name": "category_id",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "select \"ynab_transactions\".\"plan_id\", \"ynab_transactions\".\"id\", \"ynab_transactions\".\"date\", \"ynab_transactions\".\"amount\" / 1000.0 as \"amount_units\", \"ynab_transactions\".\"memo\", \"ynab_transactions\".\"cleared\", \"ynab_transactions\".\"approved\", \"ynab_transactions\".\"account_id\", \"ynab_accounts\".\"name\" as \"account_name\", \"ynab_transactions\".\"payee_id\", \"ynab_payees\".\"name\" as \"payee_name\", \"ynab_transactions\".\"category_id\", \"ynab_categories\".\"name\" as \"category_name\", \"ynab_category_groups\".\"name\" as \"category_group_name\", \"ynab_transactions\".\"transfer_account_id\" is not null as \"is_transfer\", exists (\n        select 1 from \"ynab_subtransactions\"\n        where \"ynab_subtransactions\".\"plan_id\" = \"ynab_transactions\".\"plan_id\"\n          and \"ynab_subtransactions\".\"transaction_id\" = \"ynab_transactions\".\"id\"\n          and not \"ynab_subtransactions\".\"deleted\"\n      ) as \"is_split\" from \"ynab_transactions\" left join \"ynab_accounts\" on (\"ynab_accounts\".\"plan_id\" = \"ynab_transactions\".\"plan_id\" and \"ynab_accounts\".\"id\" = \"ynab_transactions\".\"account_id\") left join \"ynab_payees\" on (\"ynab_payees\".\"plan_id\" = \"ynab_transactions\".\"plan_id\" and \"ynab_payees\".\"id\" = \"ynab_transactions\".\"payee_id\") left join \"ynab_categories\" on (\"ynab_categories\".\"plan_id\" = \"ynab_transactions\".\"plan_id\" and \"ynab_categories\".\"id\" = \"ynab_transactions\".\"category_id\") left join \"ynab_category_groups\" on (\"ynab_category_groups\".\"plan_id\" = \"ynab_categories\".\"plan_id\" and \"ynab_category_groups\".\"id\" = \"ynab_categories\".\"category_group_id\") where \"ynab_transactions\".\"deleted\" = false",
      "name": "ynab_transactions_enriched",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
