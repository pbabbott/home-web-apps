{
  "host_cpu_busy_pct": "100*(1-avg(rate(node_cpu_seconds_total{instance='192.168.4.192:9100',mode='idle'}[2m])))",
  "host_cpu_iowait_pct": "100*avg(rate(node_cpu_seconds_total{instance='192.168.4.192:9100',mode='iowait'}[2m]))",
  "host_mem_avail_GB": "node_memory_MemAvailable_bytes{instance='192.168.4.192:9100'}/1e9",
  "host_disk_busy": "rate(node_disk_io_time_seconds_total{instance='192.168.4.192:9100',device=~'nvme0n1|sda'}[2m])",
  "host_disk_wlat_ms": "rate(node_disk_write_time_seconds_total{instance='192.168.4.192:9100',device=~'nvme0n1|sda'}[2m])/rate(node_disk_writes_completed_total{instance='192.168.4.192:9100',device=~'nvme0n1|sda'}[2m])*1000",
  "host_disk_rlat_ms": "rate(node_disk_read_time_seconds_total{instance='192.168.4.192:9100',device=~'nvme0n1|sda'}[2m])/rate(node_disk_reads_completed_total{instance='192.168.4.192:9100',device=~'nvme0n1|sda'}[2m])*1000",
  "host_disk_wMBs": "rate(node_disk_written_bytes_total{instance='192.168.4.192:9100',device=~'nvme0n1|sda'}[2m])/1e6",
  "host_disk_rMBs": "rate(node_disk_read_bytes_total{instance='192.168.4.192:9100',device=~'nvme0n1|sda'}[2m])/1e6",
  "host_disk_qdepth": "rate(node_disk_io_time_weighted_seconds_total{instance='192.168.4.192:9100',device=~'nvme0n1|sda'}[2m])",
  "host_net_MBs": "sum by (direction)(label_replace(rate(node_network_receive_bytes_total{instance='192.168.4.192:9100',device='enp1s0'}[2m]),'direction','rx','','')) /1e6 or sum(rate(node_network_transmit_bytes_total{instance='192.168.4.192:9100',device='enp1s0'}[2m]))/1e6",
  "host_psi_cpu": "rate(node_pressure_cpu_waiting_seconds_total{instance='192.168.4.192:9100'}[2m])",
  "host_psi_io_full": "rate(node_pressure_io_stalled_seconds_total{instance='192.168.4.192:9100'}[2m])",
  "worker_cpu_busy_pct": "100*(1-avg by (instance)(rate(node_cpu_seconds_total{instance=~'192.168.6.2[5-7]:9100',mode='idle'}[2m])))",
  "worker_iowait_pct": "100*avg by (instance)(rate(node_cpu_seconds_total{instance=~'192.168.6.2[5-7]:9100',mode='iowait'}[2m]))",
  "worker_steal_pct": "100*avg by (instance)(rate(node_cpu_seconds_total{instance=~'192.168.6.2[5-7]:9100',mode='steal'}[2m]))",
  "worker_mem_avail_GB": "node_memory_MemAvailable_bytes{instance=~'192.168.6.2[5-7]:9100'}/1e9",
  "worker_psi_mem": "rate(node_pressure_memory_waiting_seconds_total{instance=~'192.168.6.2[5-7]:9100'}[2m])",
  "worker_psi_cpu": "rate(node_pressure_cpu_waiting_seconds_total{instance=~'192.168.6.2[5-7]:9100'}[2m])",
  "worker_psi_io": "rate(node_pressure_io_waiting_seconds_total{instance=~'192.168.6.2[5-7]:9100'}[2m])",
  "runner_cpu_cores": "sum(rate(container_cpu_usage_seconds_total{namespace='arc-runners',container!=''}[2m]))",
  "runner_throttle_ratio": "sum by (container)(rate(container_cpu_cfs_throttled_periods_total{namespace='arc-runners'}[2m]))/sum by (container)(rate(container_cpu_cfs_periods_total{namespace='arc-runners'}[2m]))",
  "host_cpu_temp": "max(node_hwmon_temp_celsius{instance='192.168.4.192:9100'})",
  "host_cpu_mhz": "avg(node_cpu_scaling_frequency_hertz{instance='192.168.4.192:9100'})/1e6"
}
