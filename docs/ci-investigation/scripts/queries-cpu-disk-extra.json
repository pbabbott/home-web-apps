  "vm_disk_wlat_worker_dev": "rate(node_disk_write_time_seconds_total{instance=~'192.168.6.2[5-7]:9100',device=~'sd[a-c]'}[2m])/rate(node_disk_writes_completed_total{instance=~'192.168.6.2[5-7]:9100',device=~'sd[a-c]'}[2m])*1000",
  "vm_disk_discard_MBs": "sum by (instance)(rate(node_disk_discarded_sectors_total[2m]))*512/1e6",
